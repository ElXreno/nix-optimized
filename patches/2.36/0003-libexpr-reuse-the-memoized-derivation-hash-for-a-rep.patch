From d5a755a9eba51f569969ee96b610aafcb5e56ec6 Mon Sep 17 00:00:00 2001
From: ElXreno <elxreno@gmail.com>
Date: Sun, 4 Oct 2026 15:38:25 +0300
Subject: [PATCH 03/12] libexpr: reuse the memoized derivation hash for a
 repeated drvPath

---
 src/libexpr/primops.cc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/libexpr/primops.cc b/src/libexpr/primops.cc
index f7e83fd3d..3c65e98c5 100644
--- a/src/libexpr/primops.cc
+++ b/src/libexpr/primops.cc
@@ -1923,7 +1923,7 @@ static void derivationStrictInternal(EvalState & state, std::string_view drvName
     /* Optimisation, but required in read-only mode! because in that
        case we don't actually write store derivations, so we can't
        read them later. */
-    {
+    if (!derivation::masked::hashes.contains(drvPath)) {
         auto h = derivation::masked::hashInput(*state.store, drv);
         derivation::masked::hashes.insert_or_assign(drvPath, std::move(h));
     }
