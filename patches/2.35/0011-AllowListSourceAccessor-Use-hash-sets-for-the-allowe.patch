From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eelco Dolstra <edolstra@gmail.com>
Date: Fri, 6 Nov 2026 15:05:18 +0100
Subject: [PATCH] AllowListSourceAccessor: Use hash sets for the allowed
 prefixes

---
 src/libfetchers/filtering-source-accessor.cc  | 98 ++++++++++++++++---
 .../nix/fetchers/filtering-source-accessor.hh | 11 +++
 2 files changed, 96 insertions(+), 13 deletions(-)

diff --git a/src/libfetchers/filtering-source-accessor.cc b/src/libfetchers/filtering-source-accessor.cc
index ceb6457d4..6c52edd2c 100644
--- a/src/libfetchers/filtering-source-accessor.cc
+++ b/src/libfetchers/filtering-source-accessor.cc
@@ -1,7 +1,8 @@
 #include "nix/fetchers/filtering-source-accessor.hh"
 #include "nix/util/sync.hh"
+#include "nix/util/strings.hh"
 
-#include <boost/unordered/concurrent_flat_set.hpp>
+#include <boost/unordered/unordered_flat_set.hpp>
 
 namespace nix {
 
@@ -36,11 +37,9 @@ SourceAccessor::Stat FilteringSourceAccessor::lstat(const CanonPath & path)
 SourceAccessor::DirEntries FilteringSourceAccessor::readDirectory(const CanonPath & path)
 {
     checkAccess(path);
-    DirEntries entries;
-    for (auto & entry : next->readDirectory(prefix / path)) {
-        if (isAllowed(path / entry.first))
-            entries.insert(std::move(entry));
-    }
+    auto entries = next->readDirectory(prefix / path);
+    if (!isAllowedRecursively(path))
+        std::erase_if(entries, [&](auto & entry) { return !isAllowed(path / entry.first); });
     return entries;
 }
 
@@ -73,8 +72,68 @@ struct AllowListSourceAccessorImpl : AllowListSourceAccessor
 private:
     void anchor() override {};
 public:
-    SharedSync<std::set<CanonPath>> allowedPrefixes;
-    boost::concurrent_flat_set<CanonPath> allowedPaths;
+    struct Prefixes
+    {
+        typedef boost::unordered_flat_set<std::string, StringViewHash, std::equal_to<>> Set;
+
+        /**
+         * The allowed prefixes, i.e. paths that are allowed along with
+         * all their descendants.
+         */
+        Set prefixes;
+
+        /**
+         * The strict ancestors of the allowed prefixes. These are
+         * allowed (so that the prefixes can be reached), but their
+         * other descendants are not.
+         */
+        Set ancestors;
+
+        void add(const CanonPath & prefix)
+        {
+            for (auto p = prefix.parent(); p; p = p->parent())
+                /* If `p` is already present, then so are its ancestors. */
+                if (!ancestors.insert(p->abs()).second)
+                    break;
+            prefixes.insert(prefix.abs());
+        }
+
+        /**
+         * Return whether `path` or one of its ancestors is an allowed
+         * prefix.
+         */
+        bool isWithinPrefix(std::string_view path) const
+        {
+            if (prefixes.empty())
+                return false;
+            if (prefixes.contains("/"))
+                return true;
+            /* Check the ancestors of `path` starting with the shortest,
+               since allowed prefixes tend to be short (e.g. store
+               paths). */
+            for (size_t pos = 1;;) {
+                auto slash = path.find('/', pos);
+                if (prefixes.contains(path.substr(0, slash)))
+                    return true;
+                if (slash == path.npos)
+                    return false;
+                pos = slash + 1;
+            }
+        }
+
+        bool isAllowed(std::string_view path) const
+        {
+            return ancestors.contains(path) || isWithinPrefix(path);
+        }
+    };
+
+    SharedSync<Prefixes> allowedPrefixes;
+
+    /**
+     * Paths that are allowed, but not their descendants. This is
+     * immutable, so it doesn't need synchronisation.
+     */
+    const std::unordered_set<CanonPath> allowedPaths;
 
     AllowListSourceAccessorImpl(
         ref<SourceAccessor> next,
@@ -82,20 +141,33 @@ public:
         const std::unordered_set<CanonPath> & allowedPaths,
         MakeNotAllowedError && makeNotAllowedError)
         : AllowListSourceAccessor(SourcePath(next), std::move(makeNotAllowedError))
-        , allowedPrefixes(allowedPrefixes.begin(), allowedPrefixes.end())
-        , allowedPaths(allowedPaths.begin(), allowedPaths.end())
+        , allowedPaths(allowedPaths)
     {
+        auto state(this->allowedPrefixes.lock());
+        for (auto & prefix : allowedPrefixes)
+            state->add(prefix);
     }
 
     bool isAllowed(const CanonPath & path) override
     {
-        /* Read lock is held for the duration of the full expression if the || doesn't short-circuit. */
-        return allowedPaths.contains(path) || path.isAllowed(*allowedPrefixes.readLock());
+        if (!allowedPaths.empty() && allowedPaths.contains(path))
+            return true;
+        return allowedPrefixes.readLock()->isAllowed(path.abs());
+    }
+
+    bool isAllowedRecursively(const CanonPath & path) override
+    {
+        return allowedPrefixes.readLock()->isWithinPrefix(path.abs());
     }
 
     void allowPrefix(CanonPath prefix) override
     {
-        allowedPrefixes.lock()->insert(std::move(prefix));
+        /* This is called frequently with prefixes that are already
+           allowed (e.g. by `copyPathToStore()`), so avoid taking the
+           write lock in that case. */
+        if (allowedPrefixes.readLock()->prefixes.contains(prefix.abs()))
+            return;
+        allowedPrefixes.lock()->add(prefix);
     }
 };
 
diff --git a/src/libfetchers/include/nix/fetchers/filtering-source-accessor.hh b/src/libfetchers/include/nix/fetchers/filtering-source-accessor.hh
index c5c1ce282..b3d219738 100644
--- a/src/libfetchers/include/nix/fetchers/filtering-source-accessor.hh
+++ b/src/libfetchers/include/nix/fetchers/filtering-source-accessor.hh
@@ -68,6 +68,17 @@ struct FilteringSourceAccessor : SourceAccessor
      * Return `true` iff access to path is allowed.
      */
     virtual bool isAllowed(const CanonPath & path) = 0;
+
+    /**
+     * Return `true` if access to `path` and all its descendants is
+     * allowed. This is an optimisation that allows `readDirectory()`
+     * to skip checking every directory entry, so it's always safe to
+     * return `false`.
+     */
+    virtual bool isAllowedRecursively(const CanonPath & path)
+    {
+        return false;
+    }
 };
 
 /**
-- 
2.56.0

